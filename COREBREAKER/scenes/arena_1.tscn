[gd_scene load_steps=9 format=3 uid="uid://cb1r2e3a4k5er"]

; ── Recursos externos: scripts ──────────────────────────────
[ext_resource type="Script" path="res://scripts/sistema_sol.gd"    id="1_sssol"]
[ext_resource type="Script" path="res://scripts/ciclo_dia.gd"      id="2_ciclo"]
[ext_resource type="Script" path="res://scripts/sistema_eventos.gd" id="3_sevt"]
[ext_resource type="Script" path="res://scripts/luz_jugador.gd"    id="4_luzj"]

; ── Sub-recursos: materiales, cielo, entorno, malla ─────────
[sub_resource type="ProceduralSkyMaterial" id="ProceduralSkyMaterial_1"]
sky_top_color     = Color(0.1, 0.2, 0.5, 1)
sky_horizon_color = Color(0.6, 0.7, 0.9, 1)
ground_bottom_color   = Color(0.1, 0.1, 0.1, 1)
ground_horizon_color  = Color(0.4, 0.3, 0.2, 1)

[sub_resource type="Sky" id="Sky_1"]
sky_material = SubResource("ProceduralSkyMaterial_1")

[sub_resource type="Environment" id="Environment_1"]
background_mode      = 2
sky                  = SubResource("Sky_1")
ambient_light_source = 2
ambient_light_color  = Color(0.4, 0.5, 0.7, 1)
ambient_light_energy = 1.0
tonemap_mode         = 2
glow_enabled         = true
glow_intensity       = 0.5

[sub_resource type="BoxMesh" id="BoxMesh_1"]
size = Vector3(20.0, 0.2, 20.0)

; ════════════════════════════════════════════════════════════
; ÁRBOL DE NODOS
; ════════════════════════════════════════════════════════════

[node name="Arena1" type="Node3D"]

; ── Coordinador del ciclo solar ──────────────────────────────
[node name="SistemaSol" type="Node" parent="."]
script = ExtResource("1_sssol")

; Nodo hijo del coordinador: lleva el reloj interno
[node name="CicloDia" type="Node" parent="SistemaSol"]
script   = ExtResource("2_ciclo")
pausado  = false

; ── Luz direccional (el sol) ─────────────────────────────────
[node name="SunLight" type="DirectionalLight3D" parent="."]
transform     = Transform3D(1, 0, 0, 0, 0.766044, 0.642788, 0, -0.642788, 0.766044, 0, 10, 0)
light_energy  = 1.0
shadow_enabled = true

; ── Entorno: cielo procedural ────────────────────────────────
[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_1")

; ── Suelo de la arena ────────────────────────────────────────
[node name="Ground" type="MeshInstance3D" parent="."]
mesh = SubResource("BoxMesh_1")

; ── Cámara de prueba ─────────────────────────────────────────
[node name="Camera3D" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.819152, 0.573576, 0, -0.573576, 0.819152, 0, 5, 7)

; ── Sistema de eventos: escucha señal y hace destellos ───────
[node name="SistemaEventos" type="Node" parent="."]
script = ExtResource("3_sevt")

; Luz del destello: OmniLight centrada, empieza apagada (energy=0)
[node name="LuzDestello" type="OmniLight3D" parent="."]
transform    = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2, 0)
light_color  = Color(0.6, 0.8, 1.0, 1)
light_energy = 0.0
omni_range   = 20.0

; ── LuzJugador: en el grupo "disparadores" ───────────────────
; El grupo permite que SistemaEventos la encuentre sin conocer su clase.
; groups=["disparadores"] es la forma de asignar grupos en el archivo .tscn
[node name="LuzJugador" type="Node" parent="." groups=["disparadores"]]
script = ExtResource("4_luzj")

; Luz OmniLight3D hija → la que realmente ilumina en la escena
[node name="OmniLuzJugador" type="OmniLight3D" parent="LuzJugador"]
transform    = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, 0)
light_color  = Color(1.0, 0.9, 0.6, 1)
light_energy = 0.0
omni_range   = 8.0

; ════════════════════════════════════════════════════════════
; CONEXIONES DE SEÑALES
; (Godot conecta estas señales automáticamente al cargar la escena)
; Formato: signal="nombre" from="emisor" to="receptor" method="función"
; ════════════════════════════════════════════════════════════

; NOTA: La conexión también se hace por código en SistemaEventos._ready().
; Este bloque es equivalente a conectarla desde el panel "Nodo" del editor.
