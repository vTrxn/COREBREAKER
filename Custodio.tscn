[sub_resource type="Shader" id="Shader_escudo"]
code = "shader_type spatial;
render_mode blend_mix, unshaded, cull_back, depth_draw_never;
uniform vec3 color_escudo : source_color = vec3(0.15, 0.9, 1.0);
void fragment() {
	float fres = pow(1.0 - clamp(dot(normalize(NORMAL), normalize(VIEW)), 0.0, 1.0), 2.4);
	float scan = 0.5 + 0.5 * sin(VERTEX.y * 18.0 - TIME * 5.5);
	ALBEDO = color_escudo * (1.2 + fres * 1.4);
	ALPHA = clamp(0.05 + fres * 0.68 + scan * 0.06 * fres, 0.0, 0.78);
}"

