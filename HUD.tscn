[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/hud.gd" id="1_hud"]
[ext_resource type="Script" path="res://scripts/mira_combo.gd" id="2_mira"]

[sub_resource type="Shader" id="Shader_vida"]
code = "shader_type canvas_item;
uniform sampler2D screen_tex : hint_screen_texture, filter_linear_mipmap;
uniform float ratio : hint_range(0.0, 1.0) = 1.0;

void fragment() {
	vec4 col = texture(screen_tex, SCREEN_UV);
	float d = clamp(1.0 - ratio, 0.0, 1.0);
	float lum = dot(col.rgb, vec3(0.299, 0.587, 0.114));
	vec3 gray = mix(col.rgb, vec3(lum), clamp(d * 1.15, 0.0, 1.0));
	float dist = length(SCREEN_UV - vec2(0.5)) * 1.4142;
	float edge = mix(0.95, 0.08, d);
	float vig = smoothstep(edge, edge + 0.5, dist) * clamp(d * 1.35, 0.0, 1.0);
	float dark = mix(1.0, 0.14, clamp((d - 0.75) / 0.25, 0.0, 1.0));
	COLOR = vec4(gray * (1.0 - vig) * dark, 1.0);
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_vida"]
shader = SubResource("Shader_vida")
shader_parameter/ratio = 1.0

